#
# Remote state, encrypted: set it up FIRST. Copy to backend.tf and fill in before the first
# `terraform init` (or run `terraform init -migrate-state` if you already have a local state).
# The default local backend writes terraform.tfstate in clear text on disk.
#
# The on-call number and email are set outside Terraform, but Terraform reads their decrypted
# SecureString values back into state on refresh. Treat the state file as sensitive: keep it in an
# encrypted, versioned, access-restricted bucket, and never commit or share it (`*.tfstate*` is
# gitignored).
#
# The bucket must already exist with, at least:
#   - default encryption with SSE-KMS (a customer managed key you control), aws:kms, bucket keys on
#   - versioning enabled (recover a corrupted or overwritten state)
#   - block public access on, and a bucket policy that denies non-TLS access and restricts reads and
#     writes to the deploy role only
terraform {
  backend "s3" {
    bucket = "<state-bucket>"
    key    = "devops-agent-oncall-connect/demo.tfstate"
    region = "<bucket-region>"

    # Server-side encryption of the state object. kms_key_id pins a specific customer managed key
    # (recommended); drop it to use the bucket default encryption.
    encrypt    = true
    kms_key_id = "<state-kms-key-arn>"

    # State locking. use_lockfile is the S3-native lock and needs Terraform >= 1.10.
    use_lockfile = true
    # On Terraform 1.9, S3-native locking is not available: remove use_lockfile and use a DynamoDB
    # lock table instead (a table with a "LockID" string partition key):
    # dynamodb_table = "<lock-table>"
  }
}
